# ─── The engine ────────────────────────────────────────────────────────────────
# Required for real analysis. Without it the server runs in DEMO mode and serves
# a canned verdict so you can still see the whole experience.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model / reasoning depth.
# claude-opus-5 is the default and what the prompt is tuned for.
TWEETOSOPHER_MODEL=claude-opus-5
TWEETOSOPHER_EFFORT=high

# ─── Twitter / X ───────────────────────────────────────────────────────────────
# App-only bearer token from the X developer portal.
# Gets you: profile, timeline (originals + retweets + replies).
X_BEARER_TOKEN=

# Optional OAuth 2.0 *user* access token with the `likes.read` scope.
# Likes are not readable with an app-only bearer — supply this to include them.
X_USER_ACCESS_TOKEN=

# ─── Substack ──────────────────────────────────────────────────────────────────
# No credentials needed — everything the pipeline reads is public.
#
# How hard the scraper works:
#   fast      one request. The RSS feed only (~20 recent posts, full bodies).
#   standard  feed + the whole archive index + Substack Notes.  [default]
#   deep      also fetches full text for posts the archive only summarised.
#             Dozens of requests and minutes, not seconds — meant for jobs.
SUBSTACK_DEPTH=standard

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8787
